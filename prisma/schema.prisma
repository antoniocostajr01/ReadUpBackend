generator client {
  provider      = "prisma-client-js"
  // Runtime da Vercel (AWS Lambda) precisa do engine rhel; "native" mantém o dev local.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookStatus {
  read
  reading
  i_want_to_read
  abandoned
  rereading
}

model User {
  id                 String    @id @default(uuid())
  name               String?
  email              String    @unique
  avatar             String?   @db.Text
  passwordHash       String?
  appleId            String?   @unique
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  genres             String[]  @default([])
  createdAt          DateTime  @default(now())

  books         Book[]
  sessions      ReadingSession[]
  refreshTokens RefreshToken[]
}

model Book {
  id           String     @id @default(uuid())
  userId       String
  title        String
  author       String?
  totalPages   Int
  details      String?
  coverUrl     String?
  isbn         String?
  coverImage   String?    @db.Text
  // Muda a cada capa enviada: vira o `?v=` do coverUrl, sem precisar ler o base64.
  coverVersion Int?
  status       BookStatus @default(reading)
  progress     Int        @default(0)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  sessions ReadingSession[]

  @@index([userId, title])
}

model ReadingSession {
  id                 String   @id @default(uuid())
  userId             String
  bookId             String
  pagesRead          Int
  thoughts           String?
  readingTimeSeconds Int
  date               DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// Refresh token opaco. Só o hash sha256 fica no banco.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  // Quando foi trocado por outro na rotação: dá a janela de tolerância.
  replacedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
